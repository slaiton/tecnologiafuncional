# Copiar como server/.env y completar

PORT=5000

# Servidor SMTP
SMTP_HOST=smtp.tudominio.com
# 587 con STARTTLS (SMTP_SECURE=false) o 465 con SSL (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contacto@tecnologiafuncional.com
SMTP_PASS=

# Remitente y destinatario (por defecto, SMTP_USER)
MAIL_FROM=
MAIL_TO=

# Orígenes permitidos para CORS, separados por coma.
# Vacío si el front y /api se sirven desde el mismo dominio.
CORS_ORIGIN=
